{
  "manifest_version": 3,
  "name": "Auto Dark Theme - Quiz URL Responder",
  "version": "2.0",
  "description": "Affiche automatiquement les réponses aux questions de quiz dans l'URL (ChatGPT, Claude, Gemini, DeepSeek)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configuration - Quiz URL Responder"
  }
}
